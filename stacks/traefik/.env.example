DOMAIN=
# Absolute path where app config lives. Derived, not configurable: `just init` sets
# it to the repo checkout's data/ dir, which is also what the restic backup covers.
CONFIG_DIR=

# Subdomain for the Traefik dashboard (defaults to 'traefik'; `just init` prompts).
SUB_DOMAIN_TRAEFIK=

# This VPS's Tailscale address (100.x.y.z), resolved by `just init` automagically
# from `tailscale ip -4`. The CoreDNS resolver in this stack answers *.DOMAIN with
# it, so admin panels resolve by name on the tailnet (see docs/tailnet.md), and
# Traefik's tailnet-only entrypoint (https-tailnet) is published on it.
TAILNET_IP=

# The address the provider maps to the internet, which Traefik's PUBLIC
# entrypoint is published on (through compose.yaml's ports, on this host IP
# only). On Oracle that's the VNIC private IP the VCN 1:1-NATs the public IP
# to; on direct-IP hosts it's the box's public IPv4. `just init`/`just prepare`
# detect it via `ip route` (excluding tailnet/loopback ranges) and write it here
# if unset. compose.yaml publishes PUBLIC_BIND and TAILNET_IP separately, so
# nothing listens on 0.0.0.0:80/443.
PUBLIC_BIND=

# Let's Encrypt contact address, rendered into traefik.yml by `just prepare`.
# Defaults to admin@$DOMAIN in `just init`; must be a real domain (example.com is
# rejected by their API) but does not need to receive mail.
ACME_EMAIL=

CLOUDFLARE_DNS_TOKEN=
TRAEFIK_DASHBOARD_CREDENTIALS=

# Shared between the crowdsec container (BOUNCER_KEY_TRAEFIK) and the bouncer plugin.
# Generate once with: openssl rand -hex 32
CROWDSEC_BOUNCER_API_KEY=
