DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). Must be numeric (0-65535); while empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=

# Per-panel subdomains; `just init` fills each with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_DECYPHARR=

# Public Traefik routers are disabled by default. These are managed by
# `just public enable|disable <service>`; they do not open UFW or create DNS records.
# JELLYFIN_ENTRYPOINTS=
# SEERR_ENTRYPOINTS=
# RADARR_ENTRYPOINTS=
# SONARR_ENTRYPOINTS=
# PROWLARR_ENTRYPOINTS=
# BAZARR_ENTRYPOINTS=
# DECYPHARR_ENTRYPOINTS=

# Zilean (DMM indexer) + its Postgres database. `just init` fills the password
# with 32 random bytes; it must be set before the first `just up`. Zilean is
# internal-only (Prowlarr reaches it at http://zilean:8181), so there is no
# SUB_DOMAIN_ZILEAN.
ZILEAN_POSTGRES_PASSWORD=
# Optional: a GitHub token avoids API rate limits during the DMM hashlist sync
# (https://github.com/settings/tokens -> classic token, read-only is enough).
# GITHUB_TOKEN=
