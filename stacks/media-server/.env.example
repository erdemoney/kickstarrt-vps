DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). While empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=
# Absolute path where app config lives. Derived, not configurable: `just init` sets
# it to the repo checkout's data/ dir, which is also what the restic backup covers.
CONFIG_DIR=

# Per-panel subdomains; `just init` prompts with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_DECYPHARR=
