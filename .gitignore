.env
.env.*
!.env.example
!.env.restic.example

# Python administration scripts
__pycache__/
*.py[cod]

# data/ is app config state (untracked, never commit). `data/*` auto-covers any
# new runtime subdir; only the traefik + recyclarr config-as-code files are
# tracked. Traefik's static config and the other config-as-code files are mounted
# directly; runtime state remains ignored.
# Recyclarr's runtime state (secrets.yml, cache, logs) stays ignored; only the
# shipped configs and the bootstrap script are tracked.
data/*
!data/traefik/
data/traefik/*
!data/traefik/traefik.yml
!data/traefik/dynamic.yml
!data/traefik/crowdsec-acquis.yaml
!data/traefik/coredns.Corefile
!data/recyclarr/
data/recyclarr/*
!data/recyclarr/bootstrap.sh
!data/recyclarr/configs/
data/recyclarr/configs/*
!data/recyclarr/configs/radarr.yml
!data/recyclarr/configs/sonarr.yml
